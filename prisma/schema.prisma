generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String?  // 'seeker', 'owner', 'both'
  area      String?
  
  // Referral system
  referralCode   String   @unique @default(cuid())
  referredBy     String?
  referralCount  Int      @default(0)
  inspectionCredits Int   @default(0)
  
  // Progressive profile
  profileCompleted Boolean @default(false)
  
  // Metadata
  ipAddress String?
  userAgent String?
  referrer  String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Email tracking
  emailSent    Boolean  @default(false)
  emailSentAt  DateTime?
  emailOpened  Boolean  @default(false)
  emailOpenedAt DateTime?
  
  // Status
  isActive     Boolean  @default(true)
  unsubscribed Boolean  @default(false)
  
  @@index([email])
  @@index([referralCode])
  @@index([createdAt])
  @@index([area])
  @@index([role])
  @@index([referredBy])
}

model Analytics {
  id        String   @id @default(cuid())
  event     String   // 'page_view', 'signup_attempt', 'signup_success', 'profile_completed', 'referral_shared', 'referral_converted'
  data      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([event])
  @@index([createdAt])
}

model GlobalStats {
  id           String   @id @default(cuid())
  signupCount  Int      @default(0)
  spotsLeft    Int      @default(500)
  lastUpdated  DateTime @default(now())
  
  @@map("global_stats")
}
